NOTION_ENV_LABEL=prod
TENANT_CONFIG_STORE_ENABLED=false
TENANT_CONFIG_DB_URL=
APP_CONFIG_ENCRYPTION_KEY=
TENANT_READ_ALLOWLIST=ootsuki,demo
TENANT_WRITE_ALLOWLIST=ootsuki,demo
TENANT_ADMIN_ALLOWLIST=ootsuki

# Vercel Cron（週次ダイジェスト）: プロジェクト環境変数に CRON_SECRET を設定すると Authorization: Bearer が付与されます。
CRON_SECRET=
# Cron が処理する tenant（カンマ区切り）。未設定時は ootsuki のみ。
DIGEST_CRON_TENANTS=ootsuki

# テックニュース画面は Notion DB「テックニュース」を読む。未設定時はコード内のIDを使う。
# AI Manager の Notion インテグレーションをそのDBに接続する。
NOTION_TECH_NEWS_DATABASE_ID=7c98ce4de1554c6388ec3118264933a9
NOTION_TECH_NEWS_DATA_SOURCE_ID=fed0b92a-3ec8-4621-b8d7-b2a4f4e31dca
# 任意。レストラン用の NOTION_API_KEY とは別インテグレーションで読むときだけ設定。
NOTION_TECH_NEWS_API_KEY=

APP_AUTH_SESSION_SECRET=replace_with_a_long_random_secret
APP_AUTH_USERS_JSON=[{"id":"owner","passwordHash":"paste_generated_hash_here"}]
AUTH_BOOTSTRAP_OWNER_IDS=owner
AUTH_BOOTSTRAP_DEMO_VIEWER_IDS=
NOTION_API_KEY=your_notion_token_here
NOTION_PROJECT_DB_ID=your_project_db_id_here
NEXT_PUBLIC_APP_NAME=AI Maneger
NOTION_OOTSUKI_PROJECT_PAGE_ID=your_ootsuki_project_page_id_here
NOTION_OOTSUKI_DAILY_SALES_DB_ID=your_daily_sales_db_id_here
NOTION_OOTSUKI_KPI_DB_ID=your_kpi_db_id_here
NOTION_OOTSUKI_MEMO_DB_ID=your_memo_db_id_here
NOTION_OOTSUKI_LINE_REPORT_PAGE_ID=your_line_report_page_id_here
NOTION_OOTSUKI_PRODUCT_COST_DB_ID=your_product_cost_db_id_here
NOTION_OOTSUKI_WEEKLY_ACTIONS_DB_ID=your_weekly_actions_db_id_here
# 任意。AI会社OSのピーク時間帯（月累計）。例: ae7a3662e7fa4300bd19f89ba2587c72
NOTION_OOTSUKI_TIME_ZONE_SALES_DB_ID=
# 任意。ドリンク比率。空の「ABC最新版」ではなく、カテゴリ1と売上金額があるDB。例: 332e9a7ee5b780cd9b3be7494fba7f70
NOTION_OOTSUKI_ABC_CATEGORY_SALES_DB_ID=
# 任意。商品粗利用。カテゴリ売上DBが空のときのドリンク比率の予備。
NOTION_OOTSUKI_ABC_ANALYSIS_DB_ID=
# 任意。原価率とFL（推移試算表）。例: 8737eedeb02f4400b614ed3ee4cc71cd
NOTION_OOTSUKI_TRIAL_BALANCE_DB_ID=
# 任意。Grok Bot の検索・アクセス（GSC/GA4）。例: 561e7b8b967c438b84279b81116aeaa1
NOTION_OOTSUKI_WEB_ANALYTICS_DB_ID=
# 任意。Grok Bot の LINE KPI / シナリオ。例: 838a47cb… / 19c008d7…
NOTION_OOTSUKI_LINE_KPI_DB_ID=
NOTION_OOTSUKI_LINE_SCENARIO_DB_ID=
# 任意。Instagram / MEO 週次手入力（OS 部門別パネル）。例: 95dec78d… / 7e61ad73…
NOTION_OOTSUKI_INSTAGRAM_WEEKLY_DB_ID=
NOTION_OOTSUKI_MEO_WEEKLY_DB_ID=
# 任意。設定するとダッシュボードに Notion の運用指示書（ページ本文）を表示します。
NOTION_OOTSUKI_INSTRUCTIONS_PAGE_ID=
# 任意。AI回答時に毎回参照するNotion DB（IDまたはNotion URL。複数はカンマ区切り）。
NOTION_OOTSUKI_AGENT_REFERENCE_DB_ID=
NOTION_OOTSUKI_AGENT_HUB_KNOWLEDGE_URLS=
NOTION_OOTSUKI_SALES_ANALYSIS_KNOWLEDGE_URLS=
NOTION_OOTSUKI_OPERATIONS_KNOWLEDGE_URLS=
NOTION_OOTSUKI_PROMOTION_KNOWLEDGE_URLS=
NOTION_OOTSUKI_RESTAURANT_CONSULT_URLS=
NOTION_OOTSUKI_WEEKLY_REVIEW_KNOWLEDGE_URLS=

# Optional: demo tenant overrides (used when NOTION_ENV_LABEL=demo or NOTION_ACTIVE_TENANT=demo)
NOTION_DEMO_API_KEY=
NOTION_DEMO_PROJECT_DB_ID=
NOTION_DEMO_OOTSUKI_PROJECT_PAGE_ID=
NOTION_DEMO_OOTSUKI_DAILY_SALES_DB_ID=
NOTION_DEMO_OOTSUKI_KPI_DB_ID=
NOTION_DEMO_OOTSUKI_MEMO_DB_ID=
NOTION_DEMO_OOTSUKI_LINE_REPORT_PAGE_ID=
NOTION_DEMO_OOTSUKI_PRODUCT_COST_DB_ID=
NOTION_DEMO_OOTSUKI_WEEKLY_ACTIONS_DB_ID=
NOTION_DEMO_OOTSUKI_INSTRUCTIONS_PAGE_ID=
# 任意。demo tenantでAI回答時に毎回参照するNotion DB（複数はカンマ区切り）。
NOTION_DEMO_AGENT_REFERENCE_DB_ID=

# 任意。tenant別指定がない場合の共通フォールバック（複数はカンマ区切り）。
NOTION_AGENT_REFERENCE_DB_ID=

# --- AI Manager × チャットボット 自動おすすめ連携 ---
# off（既定）/ shadow（生成のみ）/ publish（チャットボットが使う。CEO承認後）
CHATBOT_AUTO_STRATEGY_MODE=off
# 1回の戦略に載せる商品数の上限（既定5、最大10）
CHATBOT_STRATEGY_MAX_PRODUCTS=5
# cron の対象テナント（カンマ区切り。既定 ootsuki）
CHATBOT_STRATEGY_CRON_TENANTS=
# 送り先。supabase（既定）または admin_api
CHATBOT_STRATEGY_PUBLISHER=supabase
# チャットボットのメニューDB（在庫・提供・表示フラグの参照先）
CHATBOT_NOTION_MENU_DB_ID=
# 案A（管理API送信）を使う場合のみ。既定の supabase では不要。
CHATBOT_ADMIN_API_URL=
CHATBOT_ADMIN_API_KEY=
