# Copy to .env.local. Use a NEW Neon project. Do not point this at an existing ootsuki2 database.
# Never commit real values.

# Neon pooled or direct Postgres URL for this app only.
DATABASE_URL=

# At least 32 characters. The app passes this to Better Auth as `secret`.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Origin of this Next.js app. Local dev uses port 3003 so it does not collide with the other apps.
BETTER_AUTH_URL=http://localhost:3003

# Cloudflare R2 private bucket. Leave unset until photo upload is implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Do not set this for permanent public photo URLs. The app does not publish objects.
R2_PUBLIC_BASE_URL=

# Commercial map tile URL. Confirm the license before use. Phase 2.
MAP_TILE_URL=
